# Modèle de configuration. À copier en « .env » (jamais commité) puis à remplir.
#   cp .env.example .env
# Les lignes commentées ont une valeur par défaut : à décommenter seulement pour la changer.

# ---- WhatsApp (WAHA) ----
# Adresse de WAHA. Dans Docker Compose : http://waha:3000 (nom du conteneur).
# WAHA_URL=http://waha:3000
# Clé partagée entre WAHA et le bot. Générer une longue valeur aléatoire, par ex. :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAHA_API_KEY=
# Nom de la session WhatsApp dans WAHA (la version gratuite n'accepte que « default »).
# WAHA_SESSION=default

# ---- Google Sheet ----
# ID du Sheet : la partie entre /d/ et /edit dans son URL.
GOOGLE_SHEET_ID=
# Chemin du fichier JSON du compte de service Google (ne jamais le commiter).
# GOOGLE_FICHIER_CLE=./secrets/compte-service.json

# ---- Bot ----
# ID du groupe WhatsApp des bénévoles (à trouver avec : npm run lister-groupes).
GROUPE_ID=
# Port du serveur qui reçoit les messages de WAHA.
# PORT=3000
# Dossier où le bot garde son état (messages déjà traités…).
# DOSSIER_DONNEES=./data
# Niveau de détail des logs : debug, info, avertissement, erreur.
# NIVEAU_LOG=info
